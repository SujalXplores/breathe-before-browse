{
  "name": "breathe-before-browse",
  "version": "1.0.0",
  "description": "Mindful pause interventions for social media browsing - A Chrome extension that creates conscious moments before accessing social media",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "compress": "node scripts/compress.js",
    "postbuild": "node scripts/package.js && node scripts/compress.js",
    "package": "npm run build"
  },
  "keywords": [
    "chrome-extension",
    "mindful-browsing",
    "social-media",
    "behavioral-science",
    "digital-wellness",
    "typescript",
    "react"
  ],
  "author": "Sujal Shah",
  "license": "MIT",
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/chrome": "0.0.326",
    "@types/node": "24.0.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "terser": "5.43.1",
    "typescript": "5.8.3",
    "vite": "7.0.0"
  },
  "dependencies": {
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.524.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
